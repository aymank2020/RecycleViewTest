<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="156dp"
    android:layout_margin="6dp" android:orientation="vertical" android:padding="7dp"
    android:background="@drawable/photo_card" android:clickable="true" android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">
    <net.aymanx.examples.recycleview.ShapeTileView android:id="@+id/photo_tile"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/photo_label" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp"
        android:textColor="#273E37" android:importantForAccessibility="no" />
</LinearLayout>
